{
  "mappings": [
    {
      "trigger": "size:>1000",
      "pipe": "standard-distill"
    },
    {
      "trigger": "default",
      "pipe": "standard-distill"
    }
  ],
  "pipes": [
    {
      "name": "standard-distill",
      "description": "General-purpose log and text distillation using the high-speed Rust heuristic engine. Ideal for massive, unstructured files.",
      "nodes": [
        {
          "cmd": "C:\\Users\\luism\\Workbench\\GitHub\\std-context-lab\\.venv\\Scripts\\semantic-sift-cli.exe",
          "args": [
            "logs"
          ]
        }
      ]
    },
    {
      "name": "semantic-refinery",
      "description": "High-fidelity neural sifting. Compresses complex reasoning and code at a default 50% rate.",
      "nodes": [
        {
          "cmd": "C:\\Users\\luism\\Workbench\\GitHub\\std-context-lab\\.venv\\Scripts\\semantic-sift-cli.exe",
          "args": [
            "semantic",
            "--rate",
            "0.5"
          ]
        }
      ]
    },
    {
      "name": "research-pipe",
      "description": "Fetches a URL, converts the HTML to Markdown, and distills the content into a dense technical summary.",
      "nodes": [
        {
          "type": "mcp",
          "server": "fetch",
          "tool": "fetch",
          "input_key": "url"
        },
        {
          "cmd": "markitdown"
        },
        {
          "cmd": "C:\\Users\\luism\\Workbench\\GitHub\\std-context-lab\\.venv\\Scripts\\semantic-sift-cli.exe",
          "args": [
            "semantic",
            "--rate",
            "0.3"
          ]
        }
      ]
    },
    {
      "name": "multi-modal-pipe",
      "description": "Converts multi-modal formats (PDF, DOCX) to Markdown and distills them.",
      "nodes": [
        {
          "cmd": "markitdown"
        },
        {
          "cmd": "C:\\Users\\luism\\Workbench\\GitHub\\std-context-lab\\.venv\\Scripts\\semantic-sift-cli.exe",
          "args": [
            "semantic",
            "--rate",
            "0.3"
          ]
        }
      ]
    },
    {
      "name": "raw-db-pipe",
      "description": "Executes a raw SQL query against the mock telemetry SQLite database without any distillation.",
      "nodes": [
        {
          "type": "mcp",
          "server": "sqlite",
          "tool": "read_query",
          "input_key": "query"
        }
      ]
    },
    {
      "name": "sifted-db-pipe",
      "description": "Executes a SQL query, flattens the JSON using yq to extract event types, and distills the output.",
      "nodes": [
        {
          "type": "mcp",
          "server": "sqlite",
          "tool": "read_query",
          "input_key": "query"
        },
        {
          "cmd": "yq",
          "args": [
            "-o",
            "json",
            ".[] | .event_type"
          ]
        },
        {
          "cmd": "C:\\Users\\luism\\Workbench\\GitHub\\std-context-lab\\.venv\\Scripts\\semantic-sift-cli.exe",
          "args": [
            "logs"
          ]
        }
      ]
    },
    {
      "name": "e2e-supply-chain",
      "description": "Flagship mental supply chain. Fetches web content, formats it, takes a snapshot, injects audit logic, and ships it.",
      "nodes": [
        {
          "type": "mcp",
          "server": "fetch",
          "tool": "fetch",
          "input_key": "url"
        },
        {
          "cmd": "node",
          "args": [
            "scenarios/shared_mcps/node_modules/prettier/bin/prettier.cjs",
            "--parser",
            "markdown"
          ]
        },
        {
          "cmd": "C:\\Users\\luism\\Workbench\\GitHub\\std-context-lab\\.venv\\Scripts\\semantic-sift-cli.exe",
          "args": [
            "semantic",
            "--rate",
            "0.3"
          ],
          "tee": {
            "sink": "file",
            "path": "scenarios/07-mental-supply-chain/.tee/snapshot_before_sift.md",
            "mode": "overwrite"
          }
        },
        {
          "cmd": "node",
          "args": [
            "scenarios/07-mental-supply-chain/auditor_script.js"
          ]
        },
        {
          "cmd": "node",
          "args": [
            "scenarios/07-mental-supply-chain/ship_it_mock.js"
          ]
        }
      ]
    },
    {
      "name": "adaptive-pipe",
      "description": "Demonstrates adaptive window pressure by passing dynamic environment variables to the neural refinery.",
      "nodes": [
        {
          "cmd": "python",
          "args": [
            "scenarios/09-adaptive-pressure/pressure_gauge.py"
          ]
        },
        {
          "cmd": "C:\\Users\\luism\\Workbench\\GitHub\\std-context-lab\\.venv\\Scripts\\semantic-sift-cli.exe",
          "args": [
            "semantic",
            "--rate",
            "${SIFT_RATE}"
          ]
        }
      ]
    },
    {
