      ]
    },
    {
      "name": "research-pipe",
      "nodes": [
        {
          "type": "mcp",
          "server": "fetch",
          "tool": "fetch",
          "input_key": "url"
        },
        {
          "cmd": "markitdown"
        },
        {
          "cmd": "C:\\Users\\luism\\Workbench\\GitHub\\std-context-lab\\.venv\\Scripts\\semantic-sift-cli.exe",
          "args": [
            "semantic",
            "--rate",
            "0.3"
          ]
        }
      ]
    },
    {
      "name": "multi-modal-pipe",
      "nodes": [
        {
          "cmd": "markitdown"
        },
        {
          "cmd": "semantic-sift-cli",
          "args": ["semantic", "--rate", "0.3"]
        }
      ]
    },
    {
      "name": "e2e-supply-chain",
      "nodes": [
        {
          "type": "mcp",
          "server": "fetch",
          "tool": "fetch",
          "input_key": "url"
        },
        {
          "cmd": "node",
          "args": [
            "scenarios/shared_mcps/node_modules/prettier/bin/prettier.cjs",
            "--parser",
            "markdown"
