        {
          "cmd": "C:\\Users\\luism\\Workbench\\GitHub\\std-context-lab\\.venv\\Scripts\\semantic-sift-cli.exe",
          "args": [
            "semantic",
            "--rate",
            "0.3"
          ],
          "tee": {
            "sink": "file",
            "path": "scenarios/07-mental-supply-chain/.tee/snapshot_before_sift.md",
            "mode": "overwrite"
          }
        },
        {
          "cmd": "node",
          "args": [
            "scenarios/07-mental-supply-chain/auditor_script.js"
          ]
        },
        {
          "cmd": "node",
          "args": [
            "scenarios/07-mental-supply-chain/ship_it_mock.js"
          ]
        }
      ]
